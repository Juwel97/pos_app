    "@lucide/angular": "^1.50.0",
    "rxjs": "^7.8.2",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3"
